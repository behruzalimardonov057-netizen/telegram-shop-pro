# ================== TELEGRAM ==================
# @BotFather dan olingan yangi token
BOT_TOKEN=

# Admin Telegram ID lari (vergul bilan). @userinfobot dan oling
ADMIN_TG_IDS=

# Yangi buyurtmalar tushadigan chat/guruh ID (ixtiyoriy)
ORDERS_CHAT_ID=

# Mini App uchun HTTPS domen — SHART. Oxirida / qo'ymang
PUBLIC_URL=https://your-domain.com

# 1 = webhook (tavsiya, VPS uchun), 0 = polling
USE_WEBHOOK=0

# ================== SERVER ==================
PORT=3000
NODE_ENV=production
# Reverse proxy (Caddy/Nginx) ortida ishlasa 1
TRUST_PROXY=1
# SQLite fayl manzili (ixtiyoriy)
# DB_FILE=/var/lib/shop/shop.db

# ================== ADMIN PANEL ==================
ADMIN_LOGIN=admin
# Variant 1 — oddiy parol (kamida 10 belgi)
ADMIN_PASSWORD=
# Variant 2 — bcrypt hash (tavsiya):  npm run hash -- "parolingiz"
ADMIN_PASSWORD_HASH=

# JWT siri — majburiy, kamida 24 belgi:  openssl rand -hex 32
JWT_SECRET=

# ================== DO'KON ==================
SHOP_NAME=Baraka Market
CURRENCY=UZS

# ================== DEV ==================
# Faqat lokal test uchun! Prod'da 0 bo'lsin
ALLOW_DEV_AUTH=0

# ================== ZAXIRA (BACKUP) ==================
# Zaxiralar papkasi (bo'sh bo'lsa baza yonida ./backups)
# BACKUP_DIR=/var/lib/shop/backups
# Avto-zaxira oralig'i (soat). 0 = o'chirilgan
BACKUP_INTERVAL_HOURS=12
# Nechta oxirgi avto/qo'lda nusxa saqlansin
BACKUP_KEEP=20

# ================== RETRY (QAYTA URINISH) ==================
RETRY_MAX_ATTEMPTS=6
RETRY_BASE_DELAY_MS=2000
RETRY_MAX_DELAY_MS=900000
RETRY_TICK_MS=5000

# ================== MONITORING / LOGLAR ==================
LOG_MAX_ROWS=20000
LOG_MAX_AGE_DAYS=30

# ===== RAILWAY =====
# Railway domenni avtomatik beradi; PORT ni qo'lda yozmang.
# Volume /data ga mount qiling, baza avtomatik /data/shop.db bo'ladi.
# BACKUP_DIR=/data/backups
